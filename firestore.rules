rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profiles
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid == userId &&
               data.email is string && data.email.size() < 256;
      }
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && 
        isValidUser(incoming()) &&
        incoming().keys().hasAll(['uid', 'email']) &&
        incoming().keys().size() == 2;
      allow update: if isOwner(userId) &&
        isValidUser(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email']);
    }

    // Playlists
    match /playlists/{playlistId} {
      function isValidPlaylist(data) {
        return data.userId == request.auth.uid &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
               data.songIds is list && data.songIds.size() <= 1000 &&
               (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 1000000)) &&
               data.updatedAt == request.time;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidPlaylist(incoming()) && 
        incoming().createdAt == request.time;
      
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidPlaylist(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'songIds', 'coverUrl', 'updatedAt']);
      
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    match /likes/{likeId} {
      function isValidLike(data) {
        return data.userId == request.auth.uid &&
               data.songId is string && data.songId.size() > 0 && data.songId.size() <= 128;
      }
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidLike(incoming()) && isValidId(likeId);
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }

    match /trackMetadata/{songId} {
      function isValidMetadata(data) {
        return data.userId == request.auth.uid &&
               data.songId == songId &&
               data.coverUrl is string && data.coverUrl.size() <= 1000000 &&
               data.updatedAt == request.time;
      }
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidMetadata(incoming());
      allow update: if isSignedIn() && isOwner(existing().userId) && isValidMetadata(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['coverUrl', 'updatedAt']);
      allow delete: if isSignedIn() && isOwner(existing().userId);
    }
  }
}
